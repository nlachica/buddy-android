<?xml version="1.0" encoding="utf-8"?>
<!-- Every text of Buddy's watch app, in English. -->
<resources>
    <string name="app_name" translatable="false">Buddy</string>
    <string name="quick_talk">Talk to Buddy</string>

    <!-- The chat list -->
    <string name="chats_empty">No chats on your phone yet.</string>
    <!-- Under a chat's title when Buddy is working in it -->
    <string name="chats_working">working</string>
    <string name="chats_no_answer">Buddy on your phone isn\'t answering.</string>
    <string name="retry">Retry</string>

    <!-- Finding the phone and sending to it -->
    <string name="phone_unreachable">Can\'t reach your phone. Check Bluetooth.</string>
    <string name="phone_no_link">Buddy\'s watch link isn\'t on your phone. It needs Buddy\'s GitHub version, from the same release as this watch app.</string>
    <string name="phone_send_failed">Couldn\'t send. Is your phone nearby?</string>

    <!-- Talking with Buddy: the ongoing notification while it works (%1$s = the chat) and while the answer is said -->
    <string name="talk_chats">Pick a chat</string>
    <string name="talk_channel">Buddy\'s answers</string>
    <string name="talk_notif_waiting">Waiting for Buddy · %1$s</string>
    <string name="talk_notif_speaking">Buddy is speaking · %1$s</string>
    <!-- Reading the phone's reply aloud (the phone's audio device is Watch): notification channel name and text -->
    <string name="read_channel">Buddy reading aloud</string>
    <string name="read_notif">Reading Buddy\'s reply</string>
    <!-- Said and shown when the conversation ends without an answer -->
    <string name="talk_no_answer">Buddy on your phone didn\'t answer.</string>
    <string name="talk_stopped_working">Buddy on your phone stopped working on this, but the answer didn\'t reach the watch. It\'s in the chat on your phone.</string>
    <string name="talk_lost">Lost contact with your phone. Your message got there; Buddy\'s answer will be in the chat on your phone.</string>
    <string name="talk_connect">Couldn\'t connect to your phone. Try again.</string>
    <string name="talk_stopped">Stopped on your phone</string>
    <string name="talk_ceiling">Still working on your phone after 15 minutes. The answer will be in the chat there.</string>
    <string name="talk_no_voice">This watch can\'t read aloud (no voice installed)</string>

    <!-- The talk screen. The mic button is described for screen readers. -->
    <string name="talk_speak">Speak</string>
    <!-- The title of the watch\'s voice screen -->
    <string name="talk_prompt">Ask Buddy</string>
    <string name="talk_no_recognizer">This watch has no speech recognizer.</string>
    <string name="talk_sending">Sending…</string>
    <!-- What the user said. %1$s = their words -->
    <string name="talk_you">You: %1$s</string>
    <string name="talk_sleepy">Still working on your phone. I\'ll read the answer out when it comes.</string>

    <!-- Calls (live voice) from the watch. %1$s = the chat -->
    <string name="call_channel">Calls with Buddy</string>
    <string name="call_notif">Call with Buddy · %1$s</string>
    <string name="call_connecting">Connecting…</string>
    <string name="call_end">End</string>
    <string name="call_close">Close</string>
    <string name="call_button">Call Buddy</string>
    <string name="call_lost">Lost contact with your phone.</string>
    <string name="call_cap">The call ended after 30 minutes.</string>
    <string name="call_no_mic">This watch\'s microphone isn\'t available.</string>
    <string name="call_needs_mic">Calls need the microphone.</string>
</resources>
