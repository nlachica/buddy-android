<?xml version="1.0" encoding="utf-8"?>
<!-- What only the github build has: the link to the user's Galaxy Watch (the wear/ module), which needs Google Play
     services, and the "hey buddy" listening service with its models; see app/build.gradle.kts. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <application>
        <!-- "Hey buddy": listens on the microphone while it is on (WakeService); started by WakeWord.ensure -->
        <service
            android:name=".WakeService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Play services starts this when the watch app (same package, same signing key) sends a message -->
        <service
            android:name=".WatchLink"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/buddy" />
            </intent-filter>
            <!-- the watch opens the channel /buddy/live for a call -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/buddy" />
            </intent-filter>
        </service>
    </application>
</manifest>
