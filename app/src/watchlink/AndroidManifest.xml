<?xml version="1.0" encoding="utf-8"?>
<!-- The link to the user's Galaxy Watch (the wear/ module). Only the github build includes this folder, because it
     needs Google Play services; see app/build.gradle.kts. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Play services starts this when the watch app (same package, same signing key) sends a message -->
        <service
            android:name=".WatchLink"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/buddy" />
            </intent-filter>
            <!-- the watch opens the channel /buddy/live for a call -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/buddy" />
            </intent-filter>
        </service>
    </application>
</manifest>
